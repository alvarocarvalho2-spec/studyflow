# Supabase Auth and database.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Exact origin configured in Supabase Auth > URL Configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-configured Pix payloads generated by Inter with fixed monthly and annual amounts.
STUDYFLOW_PIX_COPIA_E_COLA_MONTHLY=
STUDYFLOW_PIX_COPIA_E_COLA_ANNUAL=

# Server-only admin access: list one or more verified StudyFlow admin emails.
STUDYFLOW_ADMIN_EMAILS=

# Server-only Supabase key used by manual payment approval actions.
SUPABASE_SECRET_KEY=
# Legacy key name supported by the server if the project still uses it.
SUPABASE_SERVICE_ROLE_KEY=
